{
  "gateway": {
    "bind": "loopback",
    "auth": { "mode": "password", "password": "strongpassword" },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["https://control.example.com"]
    },
    "tailscale": { "mode": "off" },
    "trustedProxies": ["127.0.0.1"]
  },
  "agents": { "defaults": { "workspace": "/home/russ/.openclaw/workspace" } },
  "logging": { "redactSensitive": "tools" },
  "tools": {
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "on-miss",
      "strictInlineEval": true,
      "safeBins": ["git", "jq"]
    }
  },
  "commands": {
    "useAccessGroups": true,
    "allowFrom": {
      "telegram": ["telegram:alice"]
    }
  },
  "channels": {
    "telegram": {
      "groupPolicy": "allowlist",
      "groups": {
        "*": { "requireMention": true }
      }
    },
    "discord": {}
  },
  "session": {
    "dmScope": "per-channel-peer",
    "identityLinks": {
      "wechat:alice": ["telegram:alice", "discord:alice"]
    }
  }
}
